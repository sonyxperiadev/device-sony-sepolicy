# Policy for sensor daemon
type sdsprpcd, domain;
type sdsprpcd_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(sdsprpcd)

wakelock_use(sdsprpcd)

allow sdsprpcd self:capability net_bind_service;

allow sdsprpcd self:qipcrtr_socket create_socket_perms_no_ioctl;
# TODO (b/deprecate-old-ipc-router): Remove 4.9 ipc-router compatibility `socket' when kernel 4.14 is final
allow sdsprpcd self:socket create;

allow sdsprpcd qdsp_device:chr_file { open read ioctl };
allow sdsprpcd ion_device:chr_file { open read ioctl };

allow sdsprpcd persist_file:dir search;
allow sdsprpcd persist_sensors_file:dir create_dir_perms;
allow sdsprpcd persist_sensors_file:file create_file_perms;
allow sdsprpcd mnt_vendor_file:dir { search open read };
allow sdsprpcd vendor_file:dir read;
allow sdsprpcd adsprpcd_file:dir read;

r_dir_file(sdsprpcd, sysfs_msm_subsys)
r_dir_file(sdsprpcd, sysfs_soc)
r_dir_file(sdsprpcd, sysfs_esoc)

dontaudit sdsprpcd kernel:system module_request;
